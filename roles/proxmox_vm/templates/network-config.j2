{# cloud-init's network configuration (v2) for a cloud-image install: the same cards and settings as the
   autoinstall user-data's network section (templates/user-data.j2, which tests/fuzz/fuzz_user_data.py
   compares it with). Each card is matched by its MAC address, not its name: the RHEL family's images name
   them eth0 and up, the others ens18 and up. Built as data and written with to_nice_yaml, like user-data. #}
{% set net = namespace(ethernets={}) %}
{% for nic in provision_nics %}
{%   set eth = {'match': {'macaddress': nic.mac | lower}, 'dhcp4': nic.mode == 'dhcp', 'dhcp6': false} %}
{%   if nic.mode == 'dhcp' %}
{%     set eth = eth | combine({'dhcp-identifier': 'mac'}) %}
{%     if not loop.first %}
{%       set eth = eth | combine({'dhcp4-overrides': {'use-routes': false, 'use-dns': false}}) %}
{%     endif %}
{%   elif nic.mode == 'static' %}
{%     set eth = eth | combine({'addresses': [nic.address ~ '/' ~ nic.prefix]}) %}
{%     if nic.gateway | string | length > 0 %}
{#       0.0.0.0/0, not default: cloud-init 24.4 (the RHEL family's) can't read 'default' and skips the whole
          network configuration, leaving the image's DHCP card. #}
{%       set eth = eth | combine({'routes': [{'to': '0.0.0.0/0', 'via': nic.gateway | string}]}) %}
{%     endif %}
{%   endif %}
{%   if loop.first and (nic.mode == 'static' or net_dns or net_search) %}
{%     set eth = eth | combine({'nameservers': {'addresses': net_dns, 'search': net_search}}) %}
{%   endif %}
{%   if nic.mtu | string | length > 0 %}
{%     set eth = eth | combine({'mtu': nic.mtu | int}) %}
{%   endif %}
{%   if not loop.first %}
{%     set eth = eth | combine({'optional': true}) %}
{%   endif %}
{%   set net.ethernets = net.ethernets | combine({('primary' if loop.first else nic.key): eth}) %}
{% endfor %}
{{ {'version': 2, 'ethernets': net.ethernets} | to_nice_yaml(indent=2, width=4096) }}
