#cloud-config
# Autoinstall answers. Holds a password hash: deleted from the node after the install.
# The configuration is built as data and written with to_nice_yaml, so every value comes back exactly as
# given and no inventory value can change the structure (tests/fuzz/fuzz_user_data.py checks this). The
# values used in the shell commands are also checked against roles/proxmox_vm/vars/main.yml.
{% set sudoers = '/target/etc/sudoers.d/90-ansible-' ~ admin_user %}
{% set layout = {'name': autoinstall_storage_layout, 'sizing-policy': 'all'}
     if autoinstall_storage_layout == 'lvm' else {'name': autoinstall_storage_layout} %}
{% set autoinstall = {
     'version': 1,
     'interactive-sections': [],
     'locale': autoinstall_locale,
     'keyboard': {'layout': autoinstall_keyboard_layout},
     'source': {'id': autoinstall_source_id},
     'refresh-installer': {'update': false},
     'network': {'version': 2, 'ethernets': {'primary': {
       'match': {'name': net_interface_match},
       'dhcp4': false,
       'dhcp6': false,
       'addresses': [ansible_host ~ '/' ~ net_prefix],
       'routes': [{'to': 'default', 'via': net_gateway}],
       'nameservers': {'addresses': net_dns, 'search': net_search}}}},
     'storage': {'layout': layout},
     'identity': {'hostname': inventory_hostname_short, 'realname': admin_realname,
                  'username': admin_user, 'password': provision_password_hash},
     'ssh': {'install-server': true, 'allow-pw': false, 'authorized-keys': provision_ssh_keys},
     'packages': autoinstall_packages,
     'updates': autoinstall_updates,
     'late-commands': [
       "echo '" ~ admin_user ~ " ALL=(ALL:ALL) NOPASSWD: ALL' > " ~ sudoers,
       'chmod 0440 ' ~ sudoers],
     'shutdown': 'poweroff'} %}
{{ {'autoinstall': autoinstall} | to_nice_yaml(indent=2, width=4096) }}
