## {{ ansible_managed }}
## Watches from the hardening role. Search with: ausearch -k <key>

## Identity: users, groups and passwords
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity

## Who may use sudo
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d -p wa -k sudoers

## The SSH server's configuration
-w /etc/ssh/sshd_config -p wa -k sshd
-w /etc/ssh/sshd_config.d -p wa -k sshd

## Changes to the clock and the time zone
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time-change
{% if ansible_facts.architecture == 'x86_64' %}
-a always,exit -F arch=b32 -S adjtimex,settimeofday,stime,clock_settime -k time-change
{% endif %}
-w /etc/localtime -p wa -k time-change

## Loading and removing kernel modules
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
{% if ansible_facts.architecture == 'x86_64' %}
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -k modules
{% endif %}
-w /usr/bin/kmod -p x -k modules

## The audit configuration, its tools and its logs
-w /etc/audit -p wa -k audit-config
-w /usr/sbin/auditctl -p x -k audit-tools
-w /usr/sbin/auditd -p x -k audit-tools
-w /usr/sbin/augenrules -p x -k audit-tools
-w /var/log/audit -p wa -k audit-log
