#!/bin/sh
# A stand-in for Proxmox VE's pvesm in the test "node" container: three storages allow ISO images, "local"
# (a directory), "synology-nfs" (NFS, shared by the cluster) and "squash-nfs" (NFS whose export lets only root
# in, which the tests make by hand); "backup-nfs" exists but holds backups only.
# Only the two calls the roles make are implemented, and, like the real one, only for root.
set -eu
if [ "$(id -u)" -ne 0 ]; then
  echo "please run as root" >&2
  exit 255
fi
case "${1:-} ${2:-} ${3:-}" in
  "status --content iso")
    printf '%-14s %-6s %-8s %14s %14s %14s %8s\n' Name Type Status Total Used Available %
    printf '%-14s %-6s %-8s %14s %14s %14s %8s\n' local dir active 98497780 12345678 81234567 12.53%
    printf '%-14s %-6s %-8s %14s %14s %14s %8s\n' synology-nfs nfs active 7814026240 1234567890 6579458350 15.80%
    printf '%-14s %-6s %-8s %14s %14s %14s %8s\n' squash-nfs nfs active 7814026240 1234567890 6579458350 15.80%
    ;;
  path\ *)
    volume="$2"
    storage="${volume%%:*}"
    file="${volume#*:iso/}"
    case "$storage" in
      local) echo "/var/lib/vz/template/iso/$file" ;;
      synology-nfs | squash-nfs | backup-nfs) echo "/mnt/pve/$storage/template/iso/$file" ;;
      *) echo "storage '$storage' does not exist" >&2; exit 255 ;;
    esac
    ;;
  *)
    echo "fake pvesm: unsupported arguments: $*" >&2
    exit 2
    ;;
esac
