#!/bin/sh
# Stands in for xorriso on the test node: keeps a copy of each NoCloud seed's files in /srv/seed-copies
# (tests/verify-network.yml and tests/verify-cloud-image.yml read them; the role deletes the seed itself), then
# runs xorriso.
for arg in "$@"; do
  case "$arg" in
    */seed-*/user-data | */seed-*/meta-data | */seed-*/network-config)
      copy="/srv/seed-copies/$(basename "$(dirname "$arg")")"
      mkdir -p "$copy" && cp "$arg" "$copy/$(basename "$arg")"
      ;;
  esac
done
exec /usr/bin/xorriso "$@"
