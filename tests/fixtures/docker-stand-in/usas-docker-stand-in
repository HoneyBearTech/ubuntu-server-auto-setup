#!/bin/sh
# Docker's networking for one published port, without Docker: a network namespace behind a veth called docker0,
# DNAT from the server's port 8080 to its port 80, and FORWARD through DOCKER-USER first, then accepted, as
# Docker's own rules do. Run as "start" or "stop" by the stand-in docker.service.
set -eu
case "$1" in
  start)
    ip netns add usas-ctr
    ip link add docker0 type veth peer name eth0 netns usas-ctr
    ip addr add 172.31.255.1/30 dev docker0
    ip link set docker0 up
    ip -n usas-ctr addr add 172.31.255.2/30 dev eth0
    ip -n usas-ctr link set eth0 up
    ip -n usas-ctr link set lo up
    ip -n usas-ctr route add default via 172.31.255.1
    sysctl -qw net.ipv4.ip_forward=1
    iptables -w -N DOCKER-USER 2>/dev/null || true
    iptables -w -I FORWARD 1 -j DOCKER-USER
    iptables -w -I FORWARD 2 -o docker0 -j ACCEPT
    iptables -w -I FORWARD 3 -i docker0 -j ACCEPT
    iptables -w -t nat -A PREROUTING -p tcp --dport 8080 -j DNAT --to-destination 172.31.255.2:80
    ;;
  stop)
    iptables -w -t nat -D PREROUTING -p tcp --dport 8080 -j DNAT --to-destination 172.31.255.2:80 || true
    for rule in "-j DOCKER-USER" "-o docker0 -j ACCEPT" "-i docker0 -j ACCEPT"; do
      # shellcheck disable=SC2086
      iptables -w -D FORWARD $rule || true
    done
    ip netns delete usas-ctr || true
    ;;
esac
