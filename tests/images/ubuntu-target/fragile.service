# For the updates tests' health check: runs until usas-test-kernel has been updated and the server restarted,
# then fails, as a service broken by an update would. Enabled only by the test that needs it.
[Unit]
Description=A service an update breaks (updates tests)

[Service]
# dpkg on Ubuntu and Debian, rpm on the RHEL family ($$ and %% keep systemd from expanding them, and \ the shell).
ExecStart=/bin/sh -c '{ dpkg-query -W -f=\$${Version} usas-test-kernel || rpm -q --qf "%%{VERSION}" usas-test-kernel; } 2>/dev/null | grep -qx 1.0 && exec sleep infinity'

[Install]
WantedBy=multi-user.target
